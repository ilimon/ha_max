desc: HyperAudio IEM Engine v5 HD fixed
// Signal Chain: Convolver (4-ch True Stereo) -> VDC Alignment -> Lookahead Limiter
// Features: 1.5 ms Linear Lookahead, 2 Hz Ultra-Clean DC Blocker, S-Curve Ramp, Zero Intermodulation

preGain10:0<-120,120,1>Pre Gain tenths dB
ceilDb10:-15<-600,-3,1>Limiter Ceiling tenths dBFS
relMs:80<10,500,1>Limiter Release ms

@init
isp_c = 39000; isp_hL = 39100; isp_hR = 39110; isp_p = 0;
isp_i = 0; loop(8, isp_hL[isp_i] = 0; isp_hR[isp_i] = 0; isp_i += 1; );
isp_ph = 0;
loop(3,
  isp_fr = (isp_ph + 1) * 0.25; isp_sm = 0; isp_k = 0;
  loop(8, isp_d = isp_k - (3 + isp_fr); isp_v = abs(isp_d) < 1e-9 ? 1.0 : sin($PI * isp_d) / ($PI * isp_d); isp_v *= 0.5 + 0.5 * cos($PI * isp_d / 4); isp_c[isp_ph * 8 + isp_k] = isp_v; isp_sm += isp_v; isp_k += 1; );
  isp_k = 0; loop(8, isp_c[isp_ph * 8 + isp_k] /= isp_sm; isp_k += 1; );
  isp_ph += 1;
);
preGain10   = 0;
ceilDb10    = -15;
relMs       = 80;

fs = srate > 0 ? srate : 48000;
D = floor(0.0015 * fs + 0.5);
D = max(2, min(500, D));
N = D + 1;

dlyL = 0;
dlyR = N;
reqB = 2 * N;
eB   = 3 * N;

i = 0;
loop(N,
  dlyL[i] = 0.0;
  dlyR[i] = 0.0;
  reqB[i] = 1.0;
  eB[i]   = 1.0;
  i += 1;
);

w = 0;
ew = 0;
active = 0;
eprev = 1.0;
esum = D;
chk = 0;

// High-precision DC blocker pole at 2 Hz
dcR = exp(-2.0 * $PI * 2.0 / fs);
dxL = 0.0; dyL = 0.0;
dxR = 0.0; dyR = 0.0;

fadeLen = max(1, floor(0.05 * fs));
fadeN = 0;

pre_k = 1.0 - exp(-1.0 / (0.01 * fs));
preLin = 1.0;
preTgt = 1.0;
ceilLin = 0.841395; // -1.5 dBFS
rel_k = 0.001;
prev_pre = -99999;
prev_ceil = -99999;
prev_rel = -99999;

@sample
(preGain10 != prev_pre || ceilDb10 != prev_ceil || relMs != prev_rel) ? (
  prev_pre = preGain10;
  prev_ceil = ceilDb10;
  prev_rel = relMs;
  preTgt = pow(10.0, preGain10 / 200.0);
  ceilLin = pow(10.0, min(ceilDb10, -3) / 200.0);
  rel_k = 1.0 - exp(-1.0 / (max(relMs, 1) * 0.001 * fs));
);

abs(spl0) < 1e6 ? 0 : (spl0 = 0.0);
abs(spl1) < 1e6 ? 0 : (spl1 = 0.0);

preLin += (preTgt - preLin) * pre_k;
l = spl0 * preLin;
r = spl1 * preLin;

// 2 Hz Bessel DC Blocker
yl = l - dxL + dcR * dyL; dxL = l; dyL = yl; (abs(dyL) < 1e-30) ? ( dyL = 0.0; ); l = yl;
yr = r - dxR + dcR * dyR; dxR = r; dyR = yr; (abs(dyR) < 1e-30) ? ( dyR = 0.0; ); r = yr;

  // true-peak: 4x oversampled detection (3 interpolated points, 8-tap Hann-sinc)
  isp_p = (isp_p + 1) & 7; isp_hL[isp_p] = l; isp_hR[isp_p] = r;
  isp_pk = 0; isp_ph = 0;
  loop(3,
    isp_sL = 0; isp_sR = 0; isp_k = 0;
    loop(8, isp_ix = (isp_p + 1 + isp_k) & 7; isp_cc = isp_c[isp_ph * 8 + isp_k]; isp_sL += isp_hL[isp_ix] * isp_cc; isp_sR += isp_hR[isp_ix] * isp_cc; isp_k += 1; );
    isp_pk = max(isp_pk, max(abs(isp_sL), abs(isp_sR))); isp_ph += 1;
  );
pk = max(max(abs(l), abs(r)), isp_pk);
req = pk > ceilLin ? ceilLin / pk : 1.0;
old = reqB[w];
(old < 1.0) ? ( active -= 1; );
(req < 1.0) ? ( active += 1; );
reqB[w] = req;
dlyL[w] = l;
dlyR[w] = r;

m = 1.0;
(active > 0) ? (
  i = 0;
  loop(N,
    (reqB[i] < m) ? ( m = reqB[i]; );
    i += 1;
  );
);

rec = eprev + (1.0 - eprev) * rel_k;
e = min(m, rec);
eprev = e;

esum += e - eB[ew];
eB[ew] = e;
ew += 1;
(ew >= D) ? ( ew = 0; );

chk += 1;
(chk >= N * 8) ? (
  i = 0; s = 0.0;
  loop(D, s += eB[i]; i += 1; );
  esum = s;
  chk = 0;
);

g = min(1.0, esum / D);
rp = w + 1;
(rp >= N) ? ( rp = 0; );

(fadeN < fadeLen) ? ( fadeN += 1; fg = fadeN / fadeLen; ) : ( fg = 1.0; );

spl0 = dlyL[rp] * g * fg;
spl1 = dlyR[rp] * g * fg;

spl0 = min(max(spl0, -ceilLin), ceilLin);
spl1 = min(max(spl1, -ceilLin), ceilLin);

w += 1;
(w >= N) ? ( w = 0; );
