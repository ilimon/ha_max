desc:HyperAudio Speaker Cinema Limiter v8 fixed
//tags: speaker cinema limiter true-peak

master:1<0,1,1{Bypass,Cinema Spatial Active}>Cinema Engine
inputGain10:0<-120,60,1>Input Gain tenths dB
dialogueBoost:0<0,60,1>Center Dialogue Boost tenths dB
surroundWidth:130<80,180,1>Surround Stage Width percent
ceiling10:-20<-120,-3,1>Peak Ceiling tenths dBFS
releaseMs:80<20,300,1>Limiter Release ms

@init
master = 1;
inputGain10 = 0;
dialogueBoost = 0;
surroundWidth = 130;
ceiling10 = -20;
releaseMs = 80;
fs = srate > 0 ? srate : 48000;
pre_k = 1.0 - exp(-1.0 / (0.01 * fs)); preLin = 1.0; preTgt = 1.0; ceilLin = 0.794328; rel_k = 0.001;
prev_pre = -99999; prev_ceil = -99999; prev_rel = -99999; prev_dia = -99999;
diaGain = 1.0;

// shared limiter core: 1.5 ms lookahead, sliding-min + moving-average ramp, true-peak aware
L_D = max(2, min(500, floor(0.0015 * fs + 0.5)));
L_N = L_D + 1;
L_dlyL = 40000; L_dlyR = L_dlyL + L_N; L_reqB = L_dlyR + L_N; L_eB = L_reqB + L_N;
L_i = 0;
loop(L_N, L_dlyL[L_i] = 0; L_dlyR[L_i] = 0; L_reqB[L_i] = 1.0; L_eB[L_i] = 1.0; L_i += 1; );
L_w = 0; L_ew = 0; L_active = 0; L_eprev = 1.0; L_esum = L_D; L_chk = 0;
L_fadeLen = max(1, floor(0.05 * fs)); L_fadeN = 0;
isp_c = 39000; isp_hL = 39100; isp_hR = 39110; isp_p = 0;
isp_i = 0; loop(8, isp_hL[isp_i] = 0; isp_hR[isp_i] = 0; isp_i += 1; );
isp_ph = 0;
loop(3,
  isp_fr = (isp_ph + 1) * 0.25; isp_sm = 0; isp_k = 0;
  loop(8, isp_d = isp_k - (3 + isp_fr); isp_v = abs(isp_d) < 1e-9 ? 1.0 : sin($PI * isp_d) / ($PI * isp_d); isp_v *= 0.5 + 0.5 * cos($PI * isp_d / 4); isp_c[isp_ph * 8 + isp_k] = isp_v; isp_sm += isp_v; isp_k += 1; );
  isp_k = 0; loop(8, isp_c[isp_ph * 8 + isp_k] /= isp_sm; isp_k += 1; );
  isp_ph += 1;
);

@sample
abs(spl0) < 1e6 ? 0 : (spl0 = 0.0);
abs(spl1) < 1e6 ? 0 : (spl1 = 0.0);
master == 0 ? (
  0;
) : (
(inputGain10 != prev_pre || ceiling10 != prev_ceil || releaseMs != prev_rel) ? (
    prev_pre = inputGain10; prev_ceil = ceiling10; prev_rel = releaseMs;
    preTgt = pow(10.0, inputGain10 / 200.0);
    ceilLin = pow(10.0, min(ceiling10, -3) / 200.0);
    rel_k = 1.0 - exp(-1.0 / (max(releaseMs, 20) * 0.001 * fs));
  );
  dialogueBoost != prev_dia ? ( prev_dia = dialogueBoost; diaGain = pow(10.0, dialogueBoost / 200.0); );
  preLin += (preTgt - preLin) * pre_k;
  l = spl0 * preLin; r = spl1 * preLin;
  norm = 1.0 / max(diaGain, 1.0);
  mid = 0.5 * (l + r) * diaGain * norm;
  side = 0.5 * (l - r) * (surroundWidth * 0.01) * norm;
  l = mid + side; r = mid - side;

// ---- limiter core (input l,r; output spl0,spl1; needs ceilLin, rel_k) ----
  // true-peak: 4x oversampled detection (3 interpolated points, 8-tap Hann-sinc)
  isp_p = (isp_p + 1) & 7; isp_hL[isp_p] = l; isp_hR[isp_p] = r;
  isp_pk = 0; isp_ph = 0;
  loop(3,
    isp_sL = 0; isp_sR = 0; isp_k = 0;
    loop(8, isp_ix = (isp_p + 1 + isp_k) & 7; isp_cc = isp_c[isp_ph * 8 + isp_k]; isp_sL += isp_hL[isp_ix] * isp_cc; isp_sR += isp_hR[isp_ix] * isp_cc; isp_k += 1; );
    isp_pk = max(isp_pk, max(abs(isp_sL), abs(isp_sR))); isp_ph += 1;
  );
  pk = max(max(abs(l), abs(r)), isp_pk);
  req = pk > ceilLin ? ceilLin / pk : 1.0;
  old = L_reqB[L_w];
  old < 1.0 ? ( L_active -= 1; );
  req < 1.0 ? ( L_active += 1; );
  L_reqB[L_w] = req; L_dlyL[L_w] = l; L_dlyR[L_w] = r;
  m = 1.0;
  L_active > 0 ? (
    L_i = 0;
    loop(L_N, L_reqB[L_i] < m ? ( m = L_reqB[L_i]; ); L_i += 1; );
  );
  rec = L_eprev + (1.0 - L_eprev) * rel_k;
  e = min(m, rec); L_eprev = e;
  L_esum += e - L_eB[L_ew]; L_eB[L_ew] = e; L_ew += 1; L_ew >= L_D ? ( L_ew = 0; );
  L_chk += 1;
  L_chk >= L_N * 8 ? ( L_i = 0; L_s = 0.0; loop(L_D, L_s += L_eB[L_i]; L_i += 1; ); L_esum = L_s; L_chk = 0; );
  g = min(1.0, L_esum / L_D);
  L_rp = L_w + 1; L_rp >= L_N ? ( L_rp = 0; );
  L_fadeN < L_fadeLen ? ( L_fadeN += 1; fg = L_fadeN / L_fadeLen; ) : ( fg = 1.0; );
  spl0 = min(max(L_dlyL[L_rp] * g * fg, -ceilLin), ceilLin);
  spl1 = min(max(L_dlyR[L_rp] * g * fg, -ceilLin), ceilLin);
  L_w += 1; L_w >= L_N ? ( L_w = 0; );
);
